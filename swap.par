extern funnc printf(fmt: str, ...): int;

func swap(x: &int, y: &int): void {
    *x += *y;
    *y = *x - *y;
    *x -= *y;
}

func main(): int {
    var x: int = 3;
    var y: int = 2;

    printf("before: (%i, %i)\n", x, y);
    swap(&x, &y);
    printf("after: (%i, %i)\n", x, y);
    
    return 0;
}