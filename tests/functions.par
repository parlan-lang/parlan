extern func printf(fmt: str, ...): int;

func square(n: float): float {
    return n * n;
}

func fib(n: float): float {
    if n < 2.0 {
        return n;
    }
    return fib(n - 1.0) + fib(n - 2.0);
}

func sqrt(n: float, prec: int): float {
    var x: float = n / 2.0;
    var i: int = 0;
    while i < prec {
        x = 0.5 * (x + n / x);
    }
    return x;
}

func main(): int {
    var fib5: float = fib(5.0);
    var sqfib5: float = square(fib5);
    var sqrtsqfib5: float = sqrt(sqfib5, 10);

    printf("%lf\n", sqrtsqfib5);

    return 0;
}