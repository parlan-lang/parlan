extern func printf(fmt: str, ...): int;
func set(a: int, d: int, i: int): void {
    printf("set:\n{")
    j: int = 1;
    while i > 0 {
        term: int = a + d*(j-1);
        printf("%d", term);
        if i != 1 {
            printf(", ");
        }

        j = j + 1;
        i = i - 1;
    }
    printf("}\n");
}

func main(): int {
    var firstTerm: int = 3;
    var commonDifference: int = 2;
    var terms = 5;
    set(firstTerm, commonDifference, terms);
    return 0;
}
