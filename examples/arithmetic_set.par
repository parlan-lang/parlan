extern func printf(fmt: str, ...): int;
func set(a: int, d: int, j: int): int {
    printf("set:\n{")
    for (var i: int = 1; i <= j; i = i+1) {
        int term = (a + (d*(i-1)));
        if (i!=j) {printf("%d ", term)} else {printf("%d}\n", term);}
    }
}

func main(): int {
    var firstTerm: int = 3;
    var commonDifference: int = 2;
    var terms = 5;
    set(firstTerm, commonDifference, terms);
    return 0;
}